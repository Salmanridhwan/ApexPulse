# ApexPulse environment variables
# Prinsip plan: TIDAK ADA kunci LLM di aplikasi ini.
# Satu-satunya kunci eksternal: RAG_API_KEY (hanya dipakai di backend).

# Port server produksi/dev (default 3000)
PORT=3000

# Secret untuk signing token sesi (WAJIB diganti di produksi)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Password akun demo yang di-seed saat boot (WAJIB diganti di produksi)
DEMO_PASSWORD=apexpulse2026

# === API RAG asli (isi saat kunci tersedia, lihat scripts/probe-rag.ts) ===
# RAG_PROVIDER=http
# RAG_API_URL=https://api-rag-bumd.example.go.id/v1
# RAG_API_KEY=

# Persistence MySQL (Laragon: root tanpa sandi, port 3306)
# Kalau MySQL mati, persistence otomatis fallback ke data/db.json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=apexpulse

# === SMTP untuk alert email (Fase 3) ===
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ApexPulse <alert@apexpulse.id>
