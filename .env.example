# ===== ApexPulse — contoh environment =====
# Salin jadi .env lalu sesuaikan. Semua opsional; tanpa .env pun app jalan (default aman).

# Port server (default 3000)
# PORT=3000

# Secret session HMAC (WAJIB kuat di produksi; warning keras kalau NODE_ENV=production tanpa ini)
# SESSION_SECRET=ganti-dengan-string-acak-panjang

# Password demo user (user@... / admin@apexpulse.id dll pakai ini; akun gmail pakai "123")
# DEMO_PASSWORD=apexpulse2026

# ===== MySQL persistence (Laragon) =====
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=apexpulse

# ===== (Opsional) Pra-isi konfigurasi RAG di panel admin =====
# Kalau diisi, variabel ini TIDAK otomatis dipakai — nilainya tinggal salin ke
# Admin → Konfigurasi RAG → Base URL & API Key (lihat scripts/rag-sandbox.ts untuk uji koneksi).
# RAG_BASE_URL=https://api-rag-anda.go.id/v1
# RAG_API_KEY=rag_live_xxx
