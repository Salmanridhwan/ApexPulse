# ===== Aiones Boards — contoh environment =====
# Salin jadi .env lalu sesuaikan. Semua opsional; tanpa .env pun app jalan (default aman).

# Port server (default 3000)
# PORT=3000

# Secret session HMAC — WAJIB di produksi (min. 32 karakter acak).
# Tanpa ini, server MENOLAK START saat NODE_ENV=production. Pakai nilai SAMA di semua instance.
# Buat nilai: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=ganti-dengan-string-acak-panjang

# Kunci enkripsi kunci API RAG/KMS yang disimpan di database (AES-256-GCM).
# Bila kosong memakai SESSION_SECRET. JANGAN diganti setelah dipakai —
# nilai lama tidak bisa dibuka dan kunci API harus dimasukkan ulang di panel admin.
# DATA_ENCRYPTION_KEY=

# ===== Cadangan harian otomatis =====
# Aktif otomatis bila NODE_ENV=production. 0 = mati, 1 = nyalakan di luar produksi.
# BACKUP_OTOMATIS=1
# Jam berjalan (0-23) dan lama simpan (hari).
# BACKUP_JAM=2
# BACKUP_SIMPAN_HARI=14
# Folder cadangan (default ./backups).
# BACKUP_DIR=backups

# ===== Login & Registrasi =====
# Set 'false' untuk menutup pendaftaran mandiri (hanya admin yang boleh menambah akun).
# ALLOW_REGISTRATION=true

# ===== Login dengan Google (Google Identity Services) =====
# Buat OAuth Client ID bertipe "Web application" di Google Cloud Console, lalu
# tambahkan origin aplikasi ini (mis. https://app-boards.aiones.app) ke
# "Authorized JavaScript origins". Tempel Client ID di sini agar tombol
# "Masuk dengan Google" muncul di halaman login. Client Secret TIDAK dipakai.
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Password demo user (user@... / admin@apexpulse.id dll pakai ini; akun gmail pakai "123")
# DEMO_PASSWORD=apexpulse2026

# ===== MySQL persistence (Laragon) =====
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=apexpulse

# ===== (Opsional) Pra-isi konfigurasi RAG di panel admin =====
# Kalau diisi, variabel ini TIDAK otomatis dipakai — nilainya tinggal salin ke
# Admin → Konfigurasi RAG → Base URL & API Key (lihat scripts/rag-sandbox.ts untuk uji koneksi).
# RAG_BASE_URL=https://api-rag-anda.go.id/v1
# RAG_API_KEY=rag_live_xxx

# ===== (Opsional) Email notifikasi ambang batas (SMTP) =====
# Tanpa isian ini alert tetap muncul in-app, tetapi TIDAK ada email yang dikirim
# dan notifikasi tidak pernah ditandai "email terkirim" (tanpa email palsu).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=akun@domain.go.id
# SMTP_PASS=app-password-atau-smtp-key
# MAIL_FROM=ApexPulse <no-reply@domain.go.id>
# ALERT_EMAIL_TO=direksi@domain.go.id,bpkp@domain.go.id
